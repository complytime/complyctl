{
  "id": "existing-broader-policy",
  "meta": {
    "runtime": "cel@v14.0",
    "description": "Pre-existing broader AMPEL policy with extra controls",
    "assert_mode": "AND",
    "version": 3,
    "controls": [],
    "enforce": "ON"
  },
  "tenets": [
    {
      "id": "check-pr-required",
      "title": "Verify that pull requests are required for the branch",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.require_pr == true"
    },
    {
      "id": "check-min-approvals",
      "title": "Verify minimum approval count is configured",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.min_approvals >= 2"
    },
    {
      "id": "check-force-push-blocked",
      "title": "Verify that force pushes are blocked",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.block_force_push == true"
    },
    {
      "id": "check-code-owner-review",
      "title": "Verify that code owner review is required",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.require_code_owners == true"
    },
    {
      "id": "check-stale-review-dismissal",
      "title": "Verify that stale reviews are dismissed on new commits",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.dismiss_stale == true"
    },
    {
      "id": "check-signed-commits",
      "title": "Verify that commit signing is required",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.require_signed_commits == true"
    },
    {
      "id": "check-linear-history",
      "title": "Verify that linear history is enforced",
      "predicates": {
        "types": ["http://github.com/carabiner-dev/snappy/specs/branch-rules.yaml"]
      },
      "code": "predicate.require_linear_history == true"
    }
  ]
}
